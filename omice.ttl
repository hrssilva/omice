@prefix omice: <https://hrssilva.github.io/ontology/omice.ttl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix : <https://hrssilva.github.io/ontology/omice.ttl?v=2.0#> .
@base <https://hrssilva.github.io/ontology/omice.ttl>

### Ontology Metadata
<https://hrssilva.github.io/ontology/omice.ttl> a owl:Ontology ;
    owl:versionIRI <https://hrssilva.github.io/ontology/omice.ttl?v=2.0> ;
    owl:versionInfo "2.0" .

### Metatypes
omice:TypeOfTypes a owl:Class .

omice:ObjectType a owl:Class ;
    rdfs:subClassOf omice:TypeOfTypes .

omice:QualityType a owl:Class ;
    rdfs:subClassOf omice:TypeOfTypes .

omice:RelationType a owl:Class ;
    rdfs:subClassOf omice:TypeOfTypes .

omice:EventType a owl:Class ;
    rdfs:subClassOf omice:TypeOfTypes .

omice:DispositionType a owl:Class ;
    rdfs:subClassOf omice:TypeOfTypes ;
    rdfs:comment "A type-level disposition that describes the potential for change in an entity." .

### Particulars
omice:TypeOfParticulars a owl:Class .

omice:Impetus a owl:Class ;
    rdfs:subClassOf omice:TypeOfParticulars ;
    rdfs:comment "A vector representing the direction and magnitude of a disposition’s influence over a quality domain." .

omice:QualityDomain a owl:Class ;
    rdfs:subClassOf omice:TypeOfParticulars ;
    rdfs:comment "A domain over which a quality or disposition is defined, modeled as a vector space." .

omice:DomainDimension a owl:Class ;
    rdfs:subClassOf omice:TypeOfParticulars ;
    rdfs:comment "A dimension of a quality domain, forming a basis for vector representation." .

omice:VectorComponent a owl:Class ;
    rdfs:subClassOf omice:TypeOfParticulars ;
    rdfs:comment "A scalar value associated with a domain dimension in an impetus vector." .

omice:Event a owl:Class ;
    rdfs:subClassOf omice:TypeOfParticulars .

omice:CreationEvent a owl:Class ;
    rdfs:subClassOf omice:Event .

omice:DestructionEvent a owl:Class ;
    rdfs:subClassOf omice:Event .

omice:ModificationEvent a owl:Class ;
    rdfs:subClassOf omice:Event .

omice:RelationModificationEvent a owl:Class ;
    rdfs:subClassOf omice:ModificationEvent .

omice:QualityModificationEvent a owl:Class ;
    rdfs:subClassOf omice:ModificationEvent .

### Quality Value Change Event
omice:QualityValueChangeEvent a owl:Class ;
    rdfs:subClassOf omice:QualityModificationEvent ;
    rdfs:comment "An event in which the value of a quality changes, potentially due to the manifestation of one or more dispositions." .

### Structural Properties
omice:affectsQuality a owl:ObjectProperty ;
    rdfs:domain omice:QualityValueChangeEvent ;
    rdfs:range omice:QualityType ;
    rdfs:comment "Specifies the quality affected by the value change." .

omice:manifestsDisposition a owl:ObjectProperty ;
    rdfs:domain omice:QualityValueChangeEvent ;
    rdfs:range omice:DispositionType ;
    rdfs:comment "Indicates a disposition that manifests during the event and contributes to the change in quality." .

omice:influencesQuality a owl:ObjectProperty ;
    rdfs:domain omice:DispositionType ;
    rdfs:range omice:QualityType ;
    rdfs:comment "Indicates which quality type is influenced by a disposition." .

omice:hasImpetus a owl:ObjectProperty ;
    rdfs:range omice:Impetus ;
    rdfs:comment "Relates a disposition type to its vector-based impetus over a quality domain." .

omice:overDomain a owl:ObjectProperty ;
    rdfs:domain omice:Impetus ;
    rdfs:range omice:QualityDomain ;
    rdfs:comment "Declares the quality domain over which this impetus vector is defined." .

omice:hasDimension a owl:ObjectProperty ;
    rdfs:domain omice:QualityDomain ;
    rdfs:range omice:DomainDimension ;
    rdfs:comment "Identifies dimensions within a quality domain." .

omice:hasComponent a owl:ObjectProperty ;
    rdfs:domain omice:Impetus ;
    rdfs:range omice:VectorComponent ;
    rdfs:comment "Links an impetus vector to its component along a domain dimension." .

omice:onDimension a owl:ObjectProperty ;
    rdfs:domain omice:VectorComponent ;
    rdfs:range omice:DomainDimension ;
    rdfs:comment "The domain dimension to which this vector component belongs." .

omice:hasValue a owl:DatatypeProperty ;
    rdfs:domain omice:VectorComponent ;
    rdfs:range xsd:float ;
    rdfs:comment "The numeric value of the vector component along its dimension." .

### Illustrative Example (Fragility and Break Event)
omice:StructuralIntegrityDomain a omice:QualityDomain ;
    omice:hasDimension omice:CompressiveStrain, omice:TensileStrain .

omice:CompressiveStrain a omice:DomainDimension ;
    rdfs:comment "Longitudinal compressive strain in the material." .

omice:TensileStrain a omice:DomainDimension ;
    rdfs:comment "Longitudinal tensile strain in the material." .

omice:Fragility a omice:DispositionType ;
    omice:influencesQuality omice:StructuralIntegrity ;
    omice:hasImpetusType omice:FragilityVector .

omice:StructuralIntegrity a omice:QualityType .

omice:FragilityVector a omice:ImpetusType ;
    omice:overDomain omice:StructuralIntegrityDomain ;
    omice:hasComponent omice:VecX, omice:VecY .

omice:VecX a omice:VectorComponent ;
    omice:onDimension omice:CompressiveStrain ;
    omice:hasValue 0.8 .

omice:VecY a omice:VectorComponent ;
    omice:onDimension omice:TensileStrain ;
    omice:hasValue 0.3 .

### Break Event Type and Instance
omice:BreakEvent a owl:Class ;
    rdfs:subClassOf omice:QualityValueChangeEvent ;
    rdfs:comment "An event representing the breaking of a structure due to loss of structural integrity." .

omice:BreakEvent1 a omice:BreakEvent ;
    omice:affectsQuality omice:StructuralIntegrity ;
    omice:manifestedDisposition omice:Fragility .

